# =============================================================================
# NeuroScan AI — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.env/
virtualenv/

# -----------------------------------------------------------------------------
# Python bytecode and build artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
wheels/
sdist/
*.pyo
*.pyd
MANIFEST

# -----------------------------------------------------------------------------
# Datasets (preserve directory structure and processed manifests)
# -----------------------------------------------------------------------------
# Ignore raw, external, and interim data contents
data/raw/*
data/external/*
data/interim/*
data/processed/*

# Preserve directory placeholders
!data/raw/.gitkeep
!data/external/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Track processed dataset manifest (essential metadata for splits & verification)
!data/processed/dataset_manifest.csv

# -----------------------------------------------------------------------------
# Trained model weights and checkpoints
# -----------------------------------------------------------------------------
# Large model weight file patterns
*.pth
*.pt
*.ckpt
*.onnx
*.pb
*.h5
*.keras
*.bin
*.safetensors

# Ignore models directory contents but preserve directory structure
models/*
!models/.gitkeep
!models/checkpoints/
models/checkpoints/*
!models/checkpoints/.gitkeep

# Explicitly ensure source models package is always tracked
!src/neuroscan/models/
!src/neuroscan/models/**

# -----------------------------------------------------------------------------
# Experiment outputs, logs, and caches
# -----------------------------------------------------------------------------
reports/figures/*
!reports/figures/.gitkeep

reports/metrics/*
!reports/metrics/.gitkeep
# Track verified experiment training and dataset audit summaries
!reports/metrics/*.json

outputs/
runs/
logs/
*.log

# MLflow / Weights & Biases / TensorBoard
mlruns/
mlartifacts/
wandb/
lightning_logs/

# Grad-CAM and visualization outputs
gradcam_outputs/

# -----------------------------------------------------------------------------
# Jupyter Notebook checkpoints
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Environment and secret files
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.secret
secrets/
config/local_settings.py

# -----------------------------------------------------------------------------
# Testing and coverage artifacts
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.cover
.hypothesis/

# -----------------------------------------------------------------------------
# Type-checking and linting caches
# -----------------------------------------------------------------------------
.mypy_cache/
.ruff_cache/
.pytype/

# -----------------------------------------------------------------------------
# Distribution and archives
# -----------------------------------------------------------------------------
*.tar.gz
*.tar
*.gz
*.zip
*.7z
*.rar
*.whl

# -----------------------------------------------------------------------------
# IDE and editor files
# -----------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory
.Trash-*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Temporary and misc files
# -----------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.pid
.cache/
tmp/
temp/
